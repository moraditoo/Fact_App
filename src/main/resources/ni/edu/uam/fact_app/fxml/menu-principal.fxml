<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="1050.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.MenuPrincipalController">
    <top>
        <VBox spacing="0.0">
            <MenuBar style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
                <menus>
                    <Menu text="Módulos">
                        <items>
                            <MenuItem fx:id="mnuVentas" onAction="#abrirVentas" text="Punto de Venta" />
                            <MenuItem fx:id="mnuProductos" onAction="#abrirProductos" text="Inventario de Productos" />
                            <MenuItem fx:id="mnuCategorias" onAction="#abrirCategorias" text="Categorías" />
                            <MenuItem fx:id="mnuCargos" onAction="#abrirCargos" text="Cargos y Roles" />
                            <MenuItem fx:id="mnuEmpleados" onAction="#abrirEmpleados" text="Colaboradores" />
                        </items>
                    </Menu>
                    <Menu text="Sesión">
                        <items>
                            <MenuItem onAction="#cerrarSesion" text="Cerrar Sesión" />
                            <MenuItem onAction="#salir" text="Salir del Sistema" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- Barra con iconos PNG locales de 32x32 -->
            <ToolBar style="-fx-background-color: #FFFFFF; -fx-padding: 8px 18px; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
                <items>
                    <!-- Botón Facturación -->
                    <Button fx:id="btnVentas" contentDisplay="GRAPHIC_ONLY" minHeight="46.0" minWidth="52.0" onAction="#abrirVentas" style="-fx-background-color: #ECFDF5; -fx-border-color: #A7F3D0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../icons/pos.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Facturación / Registrar ventas y cobros" />
                        </tooltip>
                    </Button>

                    <!-- Botón Productos -->
                    <Button fx:id="btnProductos" contentDisplay="GRAPHIC_ONLY" minHeight="46.0" minWidth="52.0" onAction="#abrirProductos" style="-fx-background-color: #EFF6FF; -fx-border-color: #BFDBFE; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../icons/productos.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Productos / Catálogo e inventario" />
                        </tooltip>
                    </Button>

                    <!-- Botón Categorías -->
                    <Button fx:id="btnCategorias" contentDisplay="GRAPHIC_ONLY" minHeight="46.0" minWidth="52.0" onAction="#abrirCategorias" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../icons/categoria.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Categorías / Clasificación de productos" />
                        </tooltip>
                    </Button>

                    <!-- Botón Cargos -->
                    <Button fx:id="btnCargos" contentDisplay="GRAPHIC_ONLY" minHeight="46.0" minWidth="52.0" onAction="#abrirCargos" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../icons/cargo.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Cargos / Roles laborales" />
                        </tooltip>
                    </Button>

                    <!-- Botón Empleados -->
                    <Button fx:id="btnEmpleados" contentDisplay="GRAPHIC_ONLY" minHeight="46.0" minWidth="52.0" onAction="#abrirEmpleados" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../icons/empleados.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Empleados / Gestión de personal" />
                        </tooltip>
                    </Button>

                    <Separator orientation="VERTICAL" />

                    <!-- Botón Cerrar Sesión -->
                    <Button contentDisplay="GRAPHIC_ONLY" minHeight="46.0" minWidth="52.0" onAction="#cerrarSesion" style="-fx-background-color: #FEF2F2; -fx-border-color: #FECACA; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../icons/cerrar.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Cerrar sesión" />
                        </tooltip>
                    </Button>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <!-- Centro con el logo principal -->
    <center>
        <VBox alignment="CENTER" spacing="18.0">
            <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png" />
                </image>
            </ImageView>
            <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Sistema de Facturación e Inventario" />
            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 10px 24px; -fx-border-color: #E2E8F0; -fx-border-radius: 30px; -fx-background-radius: 30px;">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Usuario conectado:" />
                <Label fx:id="lblUsuarioActual" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563EB;" text="Usuario" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #CBD5E1;" text="•" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Rol:" />
                <Label fx:id="lblRolActual" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #059669;" text="Rol" />
            </HBox>
        </VBox>
    </center>
</BorderPane>