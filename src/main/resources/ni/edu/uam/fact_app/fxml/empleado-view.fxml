<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="950.0" spacing="20.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.EmpleadoController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <VBox spacing="4.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Gestión de Empleados" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Control del personal y asignación de cargos" />
    </VBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox maxWidth="350.0" minWidth="310.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 10, 0, 0, 4);">
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Datos del Colaborador" />

            <VBox spacing="5.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="NOMBRES" />
                <TextField fx:id="txtNombres" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-padding: 8px;" />
            </VBox>

            <VBox spacing="5.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="APELLIDOS" />
                <TextField fx:id="txtApellidos" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-padding: 8px;" />
            </VBox>

            <VBox spacing="5.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="CARGO ASIGNADO" />
                <ComboBox fx:id="cmbCargo" maxWidth="1.7976931348623157E308" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" />
            </VBox>

            <VBox spacing="5.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="FECHA DE CONTRATACIÓN" />
                <DatePicker fx:id="dpFechaContratacion" maxWidth="1.7976931348623157E308" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="8.0">
                <Button maxWidth="1.7976931348623157E308" onAction="#guardar" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px; -fx-cursor: hand;" text="Guardar Empleado" />
                <HBox spacing="8.0">
                    <Button maxWidth="1.7976931348623157E308" onAction="#eliminar" style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" text="Eliminar" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="1.7976931348623157E308" onAction="#limpiar" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" text="Limpiar" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="1.7976931348623157E308" onAction="#cerrar" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px; -fx-cursor: hand;" text="Cerrar" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </VBox>

        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-padding: 16px;" HBox.hgrow="ALWAYS">
            <TextField fx:id="txtBuscar" maxWidth="320.0" promptText="🔍 Filtrar por nombre..." style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 8px;" />

            <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" style="-fx-alignment: CENTER;" text="ID" />
                    <TableColumn fx:id="colNombreCompleto" prefWidth="250.0" text="Nombre Completo" />
                    <TableColumn fx:id="colCargo" prefWidth="150.0" text="Cargo" />
                    <TableColumn fx:id="colFecha" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Contratación" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>