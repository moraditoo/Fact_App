<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="420.0" spacing="20.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.LoginController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <VBox alignment="CENTER" spacing="6.0">
        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Fact App" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Ingrese sus credenciales de acceso" />
    </VBox>

    <VBox maxWidth="340.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-padding: 24px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        <VBox spacing="6.0">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="USUARIO" />
            <TextField fx:id="txtUsuario" promptText="admin, cajero o bodega" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-padding: 9px;" />
        </VBox>

        <VBox spacing="6.0">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="CONTRASEÑA" />
            <PasswordField fx:id="txtPassword" promptText="••••••••" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-padding: 9px;" />
        </VBox>

        <Label fx:id="lblError" style="-fx-text-fill: #DC2626; -fx-font-size: 12px;" text="Credenciales incorrectas" visible="false" wrapText="true" />

        <Button maxWidth="1.7976931348623157E308" onAction="#iniciarSesion" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px; -fx-cursor: hand;" text="Iniciar Sesión" />
    </VBox>

    <VBox alignment="CENTER" spacing="2.0">
        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="Cuentas demo: admin/admin123" />
        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;" text="cajero/cajero123 | bodega/bodega123" />
    </VBox>
</VBox>