<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.CategoriaController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>

    <VBox spacing="4.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Categorías de Productos" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Clasificación del catálogo" />
    </VBox>

    <HBox spacing="24.0" VBox.vgrow="ALWAYS">
        <VBox maxWidth="350.0" minWidth="300.0" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-padding: 24px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 10, 0, 0, 4);">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Datos de Categoría" />

            <VBox spacing="6.0">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="NOMBRE DE CATEGORÍA" />
                <TextField fx:id="txtNombre" promptText="Ej. Bebidas, Accesorios..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="10.0">
                <Button maxWidth="1.7976931348623157E308" onAction="#guardar" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 11px; -fx-cursor: hand;" text="Guardar Categoría" />
                <HBox spacing="10.0">
                    <Button maxWidth="1.7976931348623157E308" onAction="#limpiar" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 9px; -fx-cursor: hand;" text="Limpiar" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="1.7976931348623157E308" onAction="#eliminar" style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 9px; -fx-cursor: hand;" text="Eliminar" HBox.hgrow="ALWAYS" />
                </HBox>
                <Button maxWidth="1.7976931348623157E308" onAction="#cerrar" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 12px; -fx-cursor: hand;" text="Cerrar ventana" />
            </VBox>
        </VBox>

        <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-padding: 20px;" HBox.hgrow="ALWAYS">
            <TextField fx:id="txtBuscar" maxWidth="320.0" promptText="🔍 Buscar categoría..." style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 9px 12px;" />

            <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="70.0" style="-fx-alignment: CENTER;" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="380.0" text="Categoría" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>