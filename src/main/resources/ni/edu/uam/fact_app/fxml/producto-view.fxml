<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="1050.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.ProductoContoller">

    <top>
        <VBox spacing="4.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Gestión de Productos" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Registro y control de inventario del catálogo" />
            </children>
        </VBox>
    </top>

    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="28.0" right="28.0" top="4.0" />
            </padding>
            <children>

                <VBox maxWidth="430.0" minWidth="380.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 10, 0, 0, 4);" HBox.hgrow="NEVER">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Datos del Producto" />

                        <GridPane hgap="12.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="100.0" prefWidth="110.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="36.0" />
                                <RowConstraints minHeight="36.0" />
                                <RowConstraints minHeight="36.0" />
                                <RowConstraints minHeight="36.0" />
                                <RowConstraints minHeight="36.0" />
                                <RowConstraints minHeight="120.0" />
                            </rowConstraints>
                            <children>
                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="CÓDIGO" GridPane.rowIndex="0" />
                                <TextField fx:id="txtCodigo" promptText="PRD-001" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="NOMBRE" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNombre" promptText="Nombre del producto" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="CATEGORÍA" GridPane.rowIndex="2" />
                                <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccionar..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="PRECIO" GridPane.rowIndex="3" />
                                <TextField fx:id="txtPrecio" promptText="0.00" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="EXISTENCIA" GridPane.rowIndex="4" />
                                <TextField fx:id="txtExistencia" promptText="0" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="IMAGEN" GridPane.rowIndex="5" />
                                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                    <children>
                                        <StackPane alignment="CENTER" maxWidth="110.0" minHeight="80.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8px;">
                                            <children>
                                                <ImageView fx:id="imgProducto" fitHeight="75.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                                            </children>
                                        </StackPane>
                                        <Button onAction="#seleccionarImagen" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 6px 12px; -fx-cursor: hand;" text="Cargar Imagen..." />
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #E2E8F0; -fx-padding: 16px;" HBox.hgrow="ALWAYS">
                    <children>
                        <TextField fx:id="txtBuscar" maxWidth="320.0" promptText="🔍 Buscar por código o nombre..." style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 6px; -fx-padding: 8px;" />

                        <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="95.0" style="-fx-alignment: CENTER;" text="Código" />
                                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                                <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
                                <TableColumn fx:id="colPrecio" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="Precio" />
                                <TableColumn fx:id="colExistencia" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Stock" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="28.0" right="28.0" top="16.0" />
            </padding>
            <children>
                <Button onAction="#eliminar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Eliminar" />
                <Button onAction="#limpiar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Limpiar" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#cerrar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Cerrar" />
                <Button onAction="#guardar" prefHeight="38.0" prefWidth="140.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Guardar" />
            </children>
        </HBox>
    </bottom>
</BorderPane>